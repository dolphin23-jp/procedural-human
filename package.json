{
  "name": "@procedural-human/root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm --filter @procedural-human/web build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test tools/*.test.mjs",
    "typecheck": "pnpm --filter @procedural-human/web typecheck",
    "check:boundaries": "node tools/check-package-boundaries.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "eslint": "9.34.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.dev/schemas/assets/as06-same-subject-continuity-provenance/v1",
  "title": "AS06 Same-Subject Continuity Provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "task",
    "recordedAt",
    "coordinateSpace",
    "source",
    "execution",
    "reviewedUlnarAnchor",
    "phase1",
    "phase2",
    "disposition",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "ph-as06-same-subject-continuity-provenance.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "task": {
      "const": "TASK-AS06"
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "patientSpaceClaim"],
      "properties": {
        "kind": {
          "const": "source-image-stack"
        },
        "patientSpaceClaim": {
          "const": false
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventorySha256",
        "firstSourceFilename",
        "lastSourceFilename",
        "verifiedChunkIndices"
      ],
      "properties": {
        "inventorySha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "firstSourceFilename": {
          "const": "avf1490a.png"
        },
        "lastSourceFilename": {
          "const": "avf1646a.png"
        },
        "verifiedChunkIndices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowRunId",
        "sourceCommitSha",
        "artifactId",
        "artifactName",
        "artifactArchiveByteSize",
        "artifactArchiveSha256",
        "phaseReports"
      ],
      "properties": {
        "workflowRunId": {
          "type": "integer",
          "minimum": 1
        },
        "sourceCommitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifactId": {
          "type": "integer",
          "minimum": 1
        },
        "artifactName": {
          "type": "string",
          "minLength": 1
        },
        "artifactArchiveByteSize": {
          "type": "integer",
          "minimum": 1
        },
        "artifactArchiveSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "phaseReports": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reviewedUlnarAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anatomicalId",
        "anchorArtifactId",
        "anchorArchiveByteSize",
        "anchorArchiveSha256",
        "anchorFrameCount"
      ],
      "properties": {
        "anatomicalId": {
          "const": "structure.ulnar_artery.left"
        },
        "anchorArtifactId": {
          "type": "integer",
          "minimum": 1
        },
        "anchorArchiveByteSize": {
          "type": "integer",
          "minimum": 1
        },
        "anchorArchiveSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "anchorFrameCount": {
          "const": 106
        }
      }
    },
    "phase1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boneContinuity",
        "ulnarBridgeSearch",
        "bifurcationSearchAuthorized"
      ],
      "properties": {
        "boneContinuity": {
          "type": "object"
        },
        "ulnarBridgeSearch": {
          "type": "object"
        },
        "bifurcationSearchAuthorized": {
          "const": true
        }
      }
    },
    "phase2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arterialBranchTopologySearch", "superficialVenousSearch"],
      "properties": {
        "arterialBranchTopologySearch": {
          "type": "object"
        },
        "superficialVenousSearch": {
          "type": "object"
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "radialArteryIdentity",
        "superficialVeinIdentity",
        "feedForwardToAS07Allowed",
        "automaticMedicalMasterPromotionAllowed",
        "basis"
      ],
      "properties": {
        "status": {
          "const": "complete-unresolved-with-stronger-same-subject-evidence"
        },
        "radialArteryIdentity": {
          "const": "unresolved"
        },
        "superficialVeinIdentity": {
          "const": "unresolved"
        },
        "feedForwardToAS07Allowed": {
          "const": true
        },
        "automaticMedicalMasterPromotionAllowed": {
          "const": false
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radialArteryIdentityEstablished",
        "brachialArteryIdentityEstablished",
        "bifurcationIdentityEstablished",
        "namedSuperficialVeinIdentityEstablished",
        "crossSubjectAtlasGeometryPromoted",
        "procedureRoleUsedAsAnatomicalIdentity",
        "medicalValidation",
        "patientSpaceGeometry",
        "automaticPromotionAllowed"
      ],
      "properties": {
        "radialArteryIdentityEstablished": {
          "const": false
        },
        "brachialArteryIdentityEstablished": {
          "const": false
        },
        "bifurcationIdentityEstablished": {
          "const": false
        },
        "namedSuperficialVeinIdentityEstablished": {
          "const": false
        },
        "crossSubjectAtlasGeometryPromoted": {
          "const": false
        },
        "procedureRoleUsedAsAnatomicalIdentity": {
          "const": false
        },
        "medicalValidation": {
          "const": false
        },
        "patientSpaceGeometry": {
          "const": false
        },
        "automaticPromotionAllowed": {
          "const": false
        }
      }
    }
  }
}

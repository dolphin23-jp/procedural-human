{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.dev/schemas/assets/a06-source-evidence-vessel-candidate-report/v1",
  "title": "A06 Source Evidence Vessel Candidate Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "task",
    "recordedAt",
    "status",
    "coordinateSpace",
    "registration",
    "support",
    "arteries",
    "namedSuperficialVeinPriors",
    "superficialTargetVein",
    "claims",
    "software"
  ],
  "properties": {
    "schema": {
      "const": "ph-a06-source-evidence-vessel-candidate-report.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "task": {
      "const": "TASK-A06"
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationLevel", "reviewStatus", "candidateOnly"],
      "properties": {
        "validationLevel": {
          "const": "V0"
        },
        "reviewStatus": {
          "const": "unreviewed"
        },
        "candidateOnly": {
          "const": true
        }
      }
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "patientSpaceClaim", "ctRegistrationEstablished"],
      "properties": {
        "kind": {
          "const": "source-image-stack"
        },
        "patientSpaceClaim": {
          "const": false
        },
        "ctRegistrationEstablished": {
          "const": false
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "proximalAtlasZ",
        "distalAtlasZ",
        "orientation",
        "searchRadiusSourcePixels",
        "selectionEvidence",
        "atlasGeometryUsedAsSubjectGeometry"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "proximalAtlasZ": {
          "type": "number"
        },
        "distalAtlasZ": {
          "type": "number"
        },
        "orientation": {
          "enum": [1, -1]
        },
        "searchRadiusSourcePixels": {
          "type": "integer",
          "minimum": 1
        },
        "selectionEvidence": {
          "type": "string",
          "minLength": 1
        },
        "atlasGeometryUsedAsSubjectGeometry": {
          "const": false
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstGlobalFrameIndex",
        "lastGlobalFrameIndex",
        "firstSourceFilename",
        "lastSourceFilename",
        "supportedFrameCount",
        "outsideSupportDisposition"
      ],
      "properties": {
        "firstGlobalFrameIndex": {
          "const": 0
        },
        "lastGlobalFrameIndex": {
          "const": 354
        },
        "firstSourceFilename": {
          "const": "avf1567a.png"
        },
        "lastSourceFilename": {
          "const": "avf1685a.png"
        },
        "supportedFrameCount": {
          "const": 355
        },
        "outsideSupportDisposition": {
          "const": "not-evaluated-by-this-pass"
        }
      }
    },
    "arteries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/arteryResult"
      }
    },
    "namedSuperficialVeinPriors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/veinPrior"
      }
    },
    "superficialTargetVein": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "anatomicalId", "reason"],
      "properties": {
        "classification": {
          "const": "not-established"
        },
        "anatomicalId": {
          "type": "null"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanEdited",
        "anatomicallyReviewed",
        "medicalValidation",
        "completeVesselExtent",
        "vesselCenterlineEstablished",
        "boundaryLumenEstablished",
        "superficialTargetVeinIdentityEstablished",
        "patientSpaceGeometry",
        "automaticPromotionAllowed"
      ],
      "properties": {
        "humanEdited": {
          "const": false
        },
        "anatomicallyReviewed": {
          "const": false
        },
        "medicalValidation": {
          "const": false
        },
        "completeVesselExtent": {
          "const": false
        },
        "vesselCenterlineEstablished": {
          "const": false
        },
        "boundaryLumenEstablished": {
          "const": false
        },
        "superficialTargetVeinIdentityEstablished": {
          "const": false
        },
        "patientSpaceGeometry": {
          "const": false
        },
        "automaticPromotionAllowed": {
          "const": false
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numpyVersion", "opencvVersion"],
      "properties": {
        "numpyVersion": {
          "type": "string",
          "minLength": 1
        },
        "opencvVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "tissueSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meanTissueSupport",
        "medianTissueSupport",
        "meanMuscleLikeSupport",
        "medianMuscleLikeSupport",
        "inCropFraction"
      ],
      "properties": {
        "meanTissueSupport": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "medianTissueSupport": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "meanMuscleLikeSupport": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "medianMuscleLikeSupport": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "inCropFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "trackMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeCount",
        "spanFrameCount",
        "coverageFraction",
        "firstGlobalFrameIndex",
        "lastGlobalFrameIndex",
        "firstSourceFilename",
        "lastSourceFilename",
        "meanGap",
        "maxGap",
        "meanJumpSourcePixels",
        "maxJumpSourcePixels",
        "medianAreaPixels",
        "medianCircularity",
        "p25Circularity",
        "medianContrast",
        "p25Contrast",
        "meanPriorDistanceSourcePixels"
      ],
      "properties": {
        "nodeCount": {
          "type": "integer",
          "minimum": 1
        },
        "spanFrameCount": {
          "type": "integer",
          "minimum": 1
        },
        "coverageFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "firstGlobalFrameIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 354
        },
        "lastGlobalFrameIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 354
        },
        "firstSourceFilename": {
          "type": "string",
          "pattern": "^avf\\d{4}[abc]\\.png$"
        },
        "lastSourceFilename": {
          "type": "string",
          "pattern": "^avf\\d{4}[abc]\\.png$"
        },
        "meanGap": {
          "type": "number",
          "minimum": 0
        },
        "maxGap": {
          "type": "integer",
          "minimum": 0
        },
        "meanJumpSourcePixels": {
          "type": "number",
          "minimum": 0
        },
        "maxJumpSourcePixels": {
          "type": "number",
          "minimum": 0
        },
        "medianAreaPixels": {
          "type": "number",
          "minimum": 0
        },
        "medianCircularity": {
          "type": "number",
          "minimum": 0
        },
        "p25Circularity": {
          "type": "number",
          "minimum": 0
        },
        "medianContrast": {
          "type": "number"
        },
        "p25Contrast": {
          "type": "number"
        },
        "meanPriorDistanceSourcePixels": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "maskFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "globalFrameIndex",
        "sourceFilename",
        "centroidSourcePixels",
        "areaPixels",
        "circularity",
        "contrast",
        "priorDistanceSourcePixels",
        "maskPath",
        "maskSha256"
      ],
      "properties": {
        "globalFrameIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 354
        },
        "sourceFilename": {
          "type": "string",
          "pattern": "^avf\\d{4}[abc]\\.png$"
        },
        "centroidSourcePixels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "areaPixels": {
          "type": "integer",
          "minimum": 1
        },
        "circularity": {
          "type": "number",
          "minimum": 0
        },
        "contrast": {
          "type": "number"
        },
        "priorDistanceSourcePixels": {
          "type": "number",
          "minimum": 0
        },
        "maskPath": {
          "type": "string",
          "minLength": 1
        },
        "maskSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "arteryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftLabel",
        "anatomicalId",
        "classification",
        "candidateTrackStatus",
        "atlasPriorTissueSupport",
        "trackMetrics",
        "maskFrameCount",
        "maskFiles"
      ],
      "properties": {
        "draftLabel": {
          "enum": ["radial_artery", "ulnar_artery"]
        },
        "anatomicalId": {
          "enum": [
            "structure.radial_artery.left",
            "structure.ulnar_artery.left"
          ]
        },
        "classification": {
          "enum": ["not-established", "intermittent-candidate"]
        },
        "candidateTrackStatus": {
          "enum": [
            "diagnostic-track-rejected",
            "source-image-supported-intermittent-v0-track"
          ]
        },
        "atlasPriorTissueSupport": {
          "$ref": "#/$defs/tissueSupport"
        },
        "trackMetrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/trackMetrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "maskFrameCount": {
          "type": "integer",
          "minimum": 0
        },
        "maskFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/maskFile"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "not-established"
              }
            },
            "required": ["classification"]
          },
          "then": {
            "properties": {
              "maskFrameCount": {
                "const": 0
              },
              "maskFiles": {
                "maxItems": 0
              },
              "candidateTrackStatus": {
                "const": "diagnostic-track-rejected"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "intermittent-candidate"
              }
            },
            "required": ["classification"]
          },
          "then": {
            "properties": {
              "maskFrameCount": {
                "minimum": 1
              },
              "maskFiles": {
                "minItems": 1
              },
              "candidateTrackStatus": {
                "const": "source-image-supported-intermittent-v0-track"
              }
            }
          }
        }
      ]
    },
    "veinPrior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftLabel",
        "anatomicalId",
        "classification",
        "priorStatus",
        "atlasPriorTissueSupport",
        "reason"
      ],
      "properties": {
        "draftLabel": {
          "enum": ["cephalic_vein", "basilic_vein"]
        },
        "anatomicalId": {
          "enum": [
            "structure.cephalic_vein.left",
            "structure.basilic_vein.left"
          ]
        },
        "classification": {
          "const": "not-established"
        },
        "priorStatus": {
          "const": "rejected-by-source-tissue-support"
        },
        "atlasPriorTissueSupport": {
          "$ref": "#/$defs/tissueSupport"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.dev/schemas/assets/source-archive-record/v1",
  "title": "Medical Authoring Source Archive Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "sourceArchiveId",
    "dataset",
    "recordedAt",
    "retrievalDate",
    "retrievalStatus",
    "canonicalLocations",
    "remoteInventorySnapshot",
    "acquisitions",
    "payloads",
    "license",
    "integrity",
    "persistentHandoff"
  ],
  "properties": {
    "schema": { "const": "ph-source-archive-record.v1" },
    "schemaVersion": { "const": "1" },
    "sourceArchiveId": { "type": "string", "minLength": 1 },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "portalDatasetId", "subjectId", "sourceClass"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "portalDatasetId": { "type": "string", "minLength": 1 },
        "subjectId": { "type": "string", "minLength": 1 },
        "sourceClass": { "type": "string", "minLength": 1 }
      }
    },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "retrievalDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "retrievalStatus": { "type": "string", "minLength": 1 },
    "canonicalLocations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "fullcolor", "pngAbdomen", "ct", "ctHeaders"],
      "properties": {
        "root": { "type": "string", "pattern": "^https://" },
        "fullcolor": { "type": "string", "pattern": "^https://" },
        "pngAbdomen": { "type": "string", "pattern": "^https://" },
        "ct": { "type": "string", "pattern": "^https://" },
        "ctHeaders": { "type": "string", "pattern": "^https://" }
      }
    },
    "remoteInventorySnapshot": { "type": "object" },
    "acquisitions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "termsUrl",
        "access",
        "registrationRequired",
        "requiredAttribution",
        "noEndorsement",
        "redistributionCondition"
      ],
      "properties": {
        "termsUrl": { "type": "string", "pattern": "^https://" },
        "access": { "type": "string", "minLength": 1 },
        "registrationRequired": { "type": "boolean" },
        "requiredAttribution": { "type": "string", "minLength": 1 },
        "noEndorsement": { "type": "boolean" },
        "redistributionCondition": { "type": "string", "minLength": 1 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredHashAlgorithm",
        "complete",
        "boundedA05AcquisitionComplete",
        "blockMedicalPromotionUntilRequiredSourceAndRegistrationIntegrityComplete",
        "note"
      ],
      "properties": {
        "requiredHashAlgorithm": { "const": "SHA-256" },
        "complete": { "type": "boolean" },
        "boundedA05AcquisitionComplete": { "type": "boolean" },
        "blockMedicalPromotionUntilRequiredSourceAndRegistrationIntegrityComplete": {
          "type": "boolean"
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "persistentHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storageClass",
        "authority",
        "libraryPath",
        "exportedAt",
        "frameCoverage",
        "chunks"
      ],
      "properties": {
        "storageClass": { "const": "external-user-library-handoff" },
        "authority": { "type": "string", "minLength": 1 },
        "libraryPath": {
          "const": "/Procedural Human/A05 Visible Human Female Source/"
        },
        "exportedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "frameCoverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedFrameCount", "chunkCount", "reconstructionRule"],
          "properties": {
            "expectedFrameCount": { "const": 451 },
            "chunkCount": { "const": 10 },
            "reconstructionRule": { "type": "string", "minLength": 1 }
          }
        },
        "chunks": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "byteSize",
              "digest",
              "sourceArtifactName",
              "libraryFilename"
            ],
            "properties": {
              "index": { "type": "integer", "minimum": 0, "maximum": 9 },
              "byteSize": { "type": "integer", "minimum": 1 },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "sourceArtifactName": { "type": "string", "minLength": 1 },
              "libraryFilename": {
                "type": "string",
                "pattern": "^chunk-[0-9]\\.zip$"
              }
            }
          }
        }
      }
    }
  }
}

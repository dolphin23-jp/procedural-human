        "humanEdited": {
          "const": false
        },
        "anatomicallyReviewed": {
          "const": false
        },
        "medicalValidation": {
          "const": false
        },
        "patientSpaceGeometry": {
          "const": false
        },
        "automaticPromotionAllowed": {
          "const": false
        }
      }
    }

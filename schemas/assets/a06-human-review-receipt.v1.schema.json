            "maximum": 451
          },
          "reviewedFrameCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 451
          },
          "acceptedFrameCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 451
          },
          "flaggedFrameCount": {
            "const": 0
          },
          "complete": {
            "const": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "draftLabel": {
                  "enum": [
                    "skin",
                    "subcutaneous_soft_tissue",
                    "major_muscle_tendon_region"
                  ]
                }
              },
              "required": [
                "draftLabel"
              ],
              "type": "object"
            },
            "then": {
              "properties": {
                "supportedFrameCount": {
                  "const": 451
                },
                "reviewedFrameCount": {
                  "const": 451
                },
                "acceptedFrameCount": {
                  "const": 451
                }
              },
              "type": "object"
            }
          },
          {
            "if": {
              "properties": {
                "draftLabel": {
                  "enum": [
                    "radius",
                    "ulna"
                  ]
                }
              },
              "required": [
                "draftLabel"
              ],
              "type": "object"
            },
            "then": {
              "properties": {
                "supportedFrameCount": {
                  "const": 357
                },
                "reviewedFrameCount": {
                  "const": 357
                },
                "acceptedFrameCount": {
                  "const": 357
                }
              },
              "type": "object"
            }
          },
          {
            "if": {
              "properties": {
                "draftLabel": {
                  "const": "ulnar_artery"
                }
              },
              "required": [
                "draftLabel"
              ],
              "type": "object"
            },
            "then": {
              "properties": {
                "supportedFrameCount": {
                  "const": 106
                },
                "reviewedFrameCount": {
                  "const": 106
                },
                "acceptedFrameCount": {
                  "const": 106
                }
              },
              "type": "object"
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "draftLabel": {
                "const": "skin"
              }
            },
            "required": [
              "draftLabel"
            ],
            "type": "object"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "draftLabel": {
                "const": "subcutaneous_soft_tissue"
              }
            },
            "required": [
              "draftLabel"
            ],
            "type": "object"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "draftLabel": {
                "const": "major_muscle_tendon_region"
              }
            },
            "required": [
              "draftLabel"
            ],
            "type": "object"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "draftLabel": {
                "const": "radius"
              }
            },
            "required": [
              "draftLabel"
            ],
            "type": "object"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "draftLabel": {
                "const": "ulna"
              }
            },
            "required": [
              "draftLabel"
            ],
            "type": "object"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "draftLabel": {
                "const": "ulnar_artery"
              }
            },
            "required": [
              "draftLabel"
            ],
            "type": "object"
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]

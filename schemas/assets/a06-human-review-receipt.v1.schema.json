          "properties": {
            "provider": {
              "const": "Google Drive"
            },
            "folderId": {
              "type": "string",
              "minLength": 1
            },
            "fileId": {
              "type": "string",
              "minLength": 1
            },
            "filename": {
              "const": "a06-human-review-2026-09-09.json"
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "byteSize": {
              "const": 215158
            },
            "digest": {
              "const": "sha256:b27d91db3714446d231aa27fca16cc620753b5cc96e0157d56e90a1afed9a8d4"
            },
            "uploadAccepted": {
              "const": true
            },
            "metadataReadBackByteSizeVerified": {
              "const": true
            },
            "sha256ReadBackVerified": {
              "const": true
            }
          }
        }
      }

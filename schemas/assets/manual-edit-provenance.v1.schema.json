{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.dev/schemas/assets/manual-edit-provenance/v1",
  "title": "Manual Edit Provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "task",
    "recordedAt",
    "coordinateSpace",
    "source",
    "manualCorrection",
    "structures",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "ph-manual-edit-provenance.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "task": {
      "const": "TASK-A06"
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "patientSpaceClaim",
        "ctRegistrationEstablished"
      ],
      "properties": {
        "kind": {
          "const": "source-image-stack"
        },
        "patientSpaceClaim": {
          "const": false
        },
        "ctRegistrationEstablished": {
          "const": false
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceFrameCount",
        "sourceFilenameShaAggregate",
        "cropFilenameShaAggregate",
        "candidateOutputDigest",
        "supplementalCandidateOutputs"
      ],
      "properties": {
        "sourceFrameCount": {
          "type": "integer",
          "minimum": 1
        },
        "sourceFilenameShaAggregate": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cropFilenameShaAggregate": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "candidateOutputDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "supplementalCandidateOutputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "labels",
              "uri",
              "digest",
              "supportStatus"
            ],
            "properties": {
              "labels": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "supportStatus": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "manualCorrection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "editorReference",
        "tool",
        "completedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending-human-edit",
            "human-correction-recorded"
          ]
        },
        "editorReference": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "human-correction-recorded"
              }
            }
          },
          "then": {
            "properties": {
              "editorReference": {
                "type": "string",
                "minLength": 1
              },
              "completedAt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "structures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "draftLabel",
          "status",
          "reason",
          "outputUri",
          "outputDigest"
        ],
        "properties": {
          "draftLabel": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending-human-edit",
              "edited",
              "reviewed-no-change",
              "blocked-source-evidence"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "outputUri": {
            "type": [
              "string",
              "null"
            ]
          },
          "outputDigest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "edited",
                    "reviewed-no-change"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "outputUri": {
                  "type": "string",
                  "minLength": 1
                },
                "outputDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanEdited",
        "anatomicallyReviewed",
        "medicalValidation",
        "patientSpaceGeometry",
        "automaticPromotionAllowed"
      ],
      "properties": {
        "humanEdited": {
          "type": "boolean"
        },
        "anatomicallyReviewed": {
          "const": false
        },
        "medicalValidation": {
          "const": false
        },
        "patientSpaceGeometry": {
          "const": false
        },
        "automaticPromotionAllowed": {
          "const": false
        }
      }
    }
  }
}

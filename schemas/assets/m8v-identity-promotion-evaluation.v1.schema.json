{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.local/schemas/assets/m8v-identity-promotion-evaluation/v1",
  "$comment": "recordedAt uses an explicit YYYY-MM-DD pattern because the repository Ajv strict validator does not install format plugins.",
  "title": "M8V identity promotion evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "task",
    "recordedAt",
    "status",
    "sourceEvidence",
    "crossChecks",
    "evaluations",
    "decision",
    "claims"
  ],
  "properties": {
    "schema": { "const": "ph-m8v-identity-promotion-evaluation.v1" },
    "schemaVersion": { "const": "1" },
    "task": { "const": "TASK-V09" },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "const": "complete" },
    "sourceEvidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "crossChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerDecisionConsistency",
        "targetDomainMembershipVerified",
        "prohibitedAssertionsRemainFalse",
        "procedureRoleExcluded",
        "ledgerSourceSnapshotHashesVerified"
      ],
      "properties": {
        "ledgerDecisionConsistency": { "const": true },
        "targetDomainMembershipVerified": { "const": true },
        "prohibitedAssertionsRemainFalse": { "const": true },
        "procedureRoleExcluded": { "const": true },
        "ledgerSourceSnapshotHashesVerified": { "const": true }
      }
    },
    "evaluations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radialArtery",
        "superficialStructure",
        "namedSuperficialVein"
      ],
      "properties": {
        "radialArtery": { "$ref": "#/$defs/evaluation" },
        "superficialStructure": { "$ref": "#/$defs/evaluation" },
        "namedSuperficialVein": { "$ref": "#/$defs/evaluation" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "anyPromotionGatePassed", "nextTask"],
      "properties": {
        "state": { "enum": ["promotion-ready", "blocked-unresolved"] },
        "anyPromotionGatePassed": { "type": "boolean" },
        "nextTask": { "const": "TASK-V10" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radialArteryPromotionGatePassed",
        "superficialStructurePromotionGatePassed",
        "namedSuperficialVeinPromotionGatePassed",
        "medicalValidation",
        "patientSpaceGeometry",
        "procedureRoleEstablished",
        "automaticPromotionAllowed"
      ],
      "properties": {
        "radialArteryPromotionGatePassed": { "type": "boolean" },
        "superficialStructurePromotionGatePassed": { "type": "boolean" },
        "namedSuperficialVeinPromotionGatePassed": { "type": "boolean" },
        "medicalValidation": { "const": false },
        "patientSpaceGeometry": { "const": false },
        "procedureRoleEstablished": { "const": false },
        "automaticPromotionAllowed": { "const": false }
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "sha256", "role"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "role": {
          "enum": ["evidence-ledger", "candidate-vessel-track-graph"]
        }
      }
    },
    "nullableTrackId": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "claimResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "state",
        "humanReviewStatus",
        "validationLevel",
        "humanReviewTargetId",
        "promotionEligible",
        "pass",
        "reasons"
      ],
      "properties": {
        "claimId": { "type": "string", "minLength": 1 },
        "state": {
          "enum": [
            "supported",
            "conflicting",
            "missing",
            "blocked",
            "unresolved"
          ]
        },
        "humanReviewStatus": {
          "enum": ["not-reviewed", "accepted", "rejected", "unresolved"]
        },
        "validationLevel": { "enum": ["V0", "V1", "V2", "V3", "V4"] },
        "humanReviewTargetId": { "$ref": "#/$defs/nullableTrackId" },
        "promotionEligible": { "type": "boolean" },
        "pass": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetClaim",
        "competitorSetId",
        "requiredClaimIds",
        "claimResults",
        "targetId",
        "targetConsistencyPass",
        "targetInAllowedCompetitorSet",
        "allRequiredClaimsPass",
        "promotionGatePassed",
        "decision",
        "blockingClaimIds",
        "blockingReasons"
      ],
      "properties": {
        "targetClaim": { "type": "string", "minLength": 1 },
        "competitorSetId": { "type": "string", "minLength": 1 },
        "requiredClaimIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "claimResults": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claimResult" }
        },
        "targetId": { "$ref": "#/$defs/nullableTrackId" },
        "targetConsistencyPass": { "type": "boolean" },
        "targetInAllowedCompetitorSet": { "type": "boolean" },
        "allRequiredClaimsPass": { "type": "boolean" },
        "promotionGatePassed": { "type": "boolean" },
        "decision": { "enum": ["promotable", "blocked-unresolved"] },
        "blockingClaimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "blockingReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

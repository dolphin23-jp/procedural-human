{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.dev/schemas/assets/a06-vessel-atlas-prior-report/v1",
  "title": "A06 Vessel Atlas Prior Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","schemaVersion","task","recordedAt","status","coordinateSpace",
    "sourceEvidence","registration","support","structures","targetVeinDisposition","claims"
  ],
  "properties": {
    "schema": { "const": "ph-a06-vessel-atlas-prior-report.v1" },
    "schemaVersion": { "const": "1" },
    "task": { "const": "TASK-A06" },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationLevel","reviewStatus","candidateOnly"],
      "properties": {
        "validationLevel": { "const": "V0" },
        "reviewStatus": { "const": "unreviewed" },
        "candidateOnly": { "const": true }
      }
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","patientSpaceClaim","ctRegistrationEstablished"],
      "properties": {
        "kind": { "const": "source-image-stack" },
        "patientSpaceClaim": { "const": false },
        "ctRegistrationEstablished": { "const": false }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "required": ["vhpBoneCandidateReport","sameCadaverBoneIdentityCorroborated","atlas"],
      "properties": {
        "vhpBoneCandidateReport": { "type": "string", "minLength": 1 },
        "sameCadaverBoneIdentityCorroborated": { "const": true },
        "atlas": {
          "type": "object",
          "required": [
            "name","sourceArchiveSha256","referenceArchiveSha256","license","upstreamModelAttribution"
          ],
          "properties": {
            "name": { "const": "Z-Anatomy Models-of-human-anatomy" },
            "sourceArchiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "referenceArchiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "license": { "const": "CC BY-SA 4.0" },
            "upstreamModelAttribution": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "registration": {
      "type": "object",
      "required": ["method","direct","swappedIdentityDiagnostic","searchUncertainty"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "direct": {
          "type": "object",
          "required": [
            "proximalAtlasZ","distalAtlasZ","atlasSpan","meanResidualSourcePixels",
            "medianResidualSourcePixels","p95ResidualSourcePixels","maxResidualSourcePixels",
            "transformAtlasXYToSourcePixels"
          ],
          "properties": {
            "proximalAtlasZ": { "type": "number" },
            "distalAtlasZ": { "type": "number" },
            "atlasSpan": { "type": "number", "minimum": 0.08, "maximum": 0.18 },
            "meanResidualSourcePixels": { "type": "number", "minimum": 0, "maximum": 25 },
            "medianResidualSourcePixels": { "type": "number", "minimum": 0 },
            "p95ResidualSourcePixels": { "type": "number", "minimum": 0 },
            "maxResidualSourcePixels": { "type": "number", "minimum": 0 },
            "transformAtlasXYToSourcePixels": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number" }
              }
            }
          }
        },
        "swappedIdentityDiagnostic": { "type": "object" },
        "searchUncertainty": {
          "type": "object",
          "required": [
            "p95BoneRegistrationResidualSourcePixels",
            "crossAtlasBufferSourcePixels",
            "searchRadiusSourcePixels"
          ],
          "properties": {
            "p95BoneRegistrationResidualSourcePixels": { "type": "number", "minimum": 0 },
            "crossAtlasBufferSourcePixels": { "type": "number", "minimum": 0 },
            "searchRadiusSourcePixels": { "type": "integer", "minimum": 40 }
          }
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstGlobalFrameIndex","lastGlobalFrameIndex","firstSourceFilename",
        "lastSourceFilename","supportedFrameCount","outsideSupportDisposition"
      ],
      "properties": {
        "firstGlobalFrameIndex": { "const": 0 },
        "lastGlobalFrameIndex": { "const": 354 },
        "firstSourceFilename": { "const": "avf1567a.png" },
        "lastSourceFilename": { "const": "avf1685a.png" },
        "supportedFrameCount": { "const": 355 },
        "outsideSupportDisposition": { "const": "no-atlas-prior-from-this-pass" }
      }
    },
    "structures": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "draftLabel","anatomicalId","role","priorStatus","supportedFrameCount",
          "inCropFrameCount","inCropFraction","frames"
        ],
        "properties": {
          "draftLabel": {
            "enum": ["radial_artery","ulnar_artery","cephalic_vein","basilic_vein"]
          },
          "anatomicalId": { "type": "string", "pattern": "^structure\\.[a-z_]+\\.left$" },
          "role": {
            "enum": ["arterial-reference-prior","named-superficial-vein-reference-prior"]
          },
          "priorStatus": { "const": "atlas-derived-search-prior-only" },
          "supportedFrameCount": { "const": 355 },
          "inCropFrameCount": { "type": "integer", "minimum": 0, "maximum": 355 },
          "inCropFraction": { "type": "number", "minimum": 0.95, "maximum": 1 },
          "frames": {
            "type": "array",
            "minItems": 355,
            "maxItems": 355,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "globalFrameIndex","sourceFilename","atlasZ","priorCenterSourcePixels",
                "searchRadiusSourcePixels","inCrop"
              ],
              "properties": {
                "globalFrameIndex": { "type": "integer", "minimum": 0, "maximum": 354 },
                "sourceFilename": { "type": "string", "pattern": "^avf\\d{4}[abc]\\.png$" },
                "atlasZ": { "type": "number" },
                "priorCenterSourcePixels": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x","y"],
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  }
                },
                "searchRadiusSourcePixels": { "type": "integer", "minimum": 40 },
                "inCrop": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "targetVeinDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["superficialTargetVeinAnatomicalId","candidateNamedVeinPriors","status"],
      "properties": {
        "superficialTargetVeinAnatomicalId": { "type": "null" },
        "candidateNamedVeinPriors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "enum": ["structure.cephalic_vein.left","structure.basilic_vein.left"] }
        },
        "status": { "const": "unresolved-until-vhp-source-evidence-is-evaluated" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atlasGeometryUsedAsSubjectGeometry","vesselMaskGenerated","vesselCenterlineEstablished",
        "superficialTargetVeinIdentityEstablished","humanEdited","anatomicallyReviewed",
        "medicalValidation","patientSpaceGeometry","automaticPromotionAllowed"
      ],
      "properties": {
        "atlasGeometryUsedAsSubjectGeometry": { "const": false },
        "vesselMaskGenerated": { "const": false },
        "vesselCenterlineEstablished": { "const": false },
        "superficialTargetVeinIdentityEstablished": { "const": false },
        "humanEdited": { "const": false },
        "anatomicallyReviewed": { "const": false },
        "medicalValidation": { "const": false },
        "patientSpaceGeometry": { "const": false },
        "automaticPromotionAllowed": { "const": false }
      }
    }
  }
}

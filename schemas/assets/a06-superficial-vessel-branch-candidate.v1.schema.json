{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.dev/schemas/assets/a06-superficial-vessel-branch-candidate/v1",
  "title": "A06 Superficial Vessel Branch Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "task",
    "recordedAt",
    "draftLabel",
    "classification",
    "coordinateSpace",
    "selection",
    "continuousSegment",
    "maskFrameCount",
    "maskFiles",
    "identityDisposition",
    "claims"
  ],
  "properties": {
    "schema": { "const": "ph-a06-superficial-vessel-branch-candidate.v1" },
    "schemaVersion": { "const": "1" },
    "task": { "const": "TASK-A06" },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "draftLabel": { "const": "superficial_vessel_branch_candidate_1" },
    "classification": {
      "const": "continuous-superficial-vessel-branch-candidate"
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "patientSpaceClaim"],
      "properties": {
        "kind": { "const": "source-image-stack" },
        "patientSpaceClaim": { "const": false }
      }
    },
    "selection": { "type": "object" },
    "continuousSegment": {
      "type": "object",
      "required": [
        "frameCount",
        "firstGlobalFrameIndex",
        "lastGlobalFrameIndex",
        "firstSourceFilename",
        "lastSourceFilename",
        "directDiscoveryNodeCount",
        "sourceRecoveredGapFrameCount",
        "coverageFraction",
        "meanJumpSourcePixels",
        "maxJumpSourcePixels",
        "medianAreaPixels",
        "medianCircularity",
        "p25Circularity",
        "medianContrast",
        "p25Contrast",
        "minimumContrast",
        "medianSkinDepthPixels",
        "p25SkinDepthPixels",
        "p75SkinDepthPixels",
        "maxSkinDepthPixels"
      ],
      "properties": {
        "frameCount": { "type": "integer", "minimum": 60 },
        "firstGlobalFrameIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 450
        },
        "lastGlobalFrameIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 450
        },
        "firstSourceFilename": {
          "type": "string",
          "pattern": "^avf\\d{4}[abc]\\.png$"
        },
        "lastSourceFilename": {
          "type": "string",
          "pattern": "^avf\\d{4}[abc]\\.png$"
        },
        "directDiscoveryNodeCount": { "type": "integer", "minimum": 1 },
        "sourceRecoveredGapFrameCount": { "type": "integer", "minimum": 0 },
        "coverageFraction": { "const": 1 },
        "meanJumpSourcePixels": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.5
        },
        "maxJumpSourcePixels": { "type": "number", "minimum": 0, "maximum": 5 },
        "medianAreaPixels": { "type": "number", "minimum": 1 },
        "medianCircularity": { "type": "number", "minimum": 0.4 },
        "p25Circularity": { "type": "number", "minimum": 0.3 },
        "medianContrast": { "type": "number", "minimum": 30 },
        "p25Contrast": { "type": "number", "minimum": 20 },
        "minimumContrast": { "type": "number", "minimum": 20 },
        "medianSkinDepthPixels": {
          "type": "number",
          "minimum": 3,
          "maximum": 15
        },
        "p25SkinDepthPixels": { "type": "number", "minimum": 3 },
        "p75SkinDepthPixels": { "type": "number", "minimum": 3 },
        "maxSkinDepthPixels": { "type": "number", "minimum": 3, "maximum": 25 }
      }
    },
    "maskFrameCount": { "type": "integer", "minimum": 60 },
    "maskFiles": {
      "type": "array",
      "minItems": 60,
      "items": { "$ref": "#/$defs/maskFile" }
    },
    "identityDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anatomicalId",
        "vesselClass",
        "venousIdentityEstablished",
        "namedVeinIdentityEstablished",
        "proceduralTargetBindingAllowed",
        "reason"
      ],
      "properties": {
        "anatomicalId": { "type": "null" },
        "vesselClass": { "const": "superficial-vessel-branch" },
        "venousIdentityEstablished": { "const": false },
        "namedVeinIdentityEstablished": { "const": false },
        "proceduralTargetBindingAllowed": { "const": false },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanEdited",
        "anatomicallyReviewed",
        "medicalValidation",
        "venousIdentityEstablished",
        "namedVeinIdentityEstablished",
        "completeVesselExtent",
        "patientSpaceGeometry",
        "automaticPromotionAllowed"
      ],
      "properties": {
        "humanEdited": { "const": false },
        "anatomicallyReviewed": { "const": false },
        "medicalValidation": { "const": false },
        "venousIdentityEstablished": { "const": false },
        "namedVeinIdentityEstablished": { "const": false },
        "completeVesselExtent": { "const": false },
        "patientSpaceGeometry": { "const": false },
        "automaticPromotionAllowed": { "const": false }
      }
    }
  },
  "$defs": {
    "maskFile": {
      "type": "object",
      "required": [
        "globalFrameIndex",
        "sourceFilename",
        "evidenceKind",
        "centroidSourcePixels",
        "areaPixels",
        "circularity",
        "contrast",
        "skinDepthPixels",
        "meanRgb",
        "maskPath",
        "maskSha256"
      ]
    }
  }
}

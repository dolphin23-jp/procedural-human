{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.local/schemas/assets/m8v-evidence-ledger/v1",
  "title": "M8V vessel identity evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "task",
    "recordedAt",
    "status",
    "sourceEvidence",
    "humanReviewSessions",
    "claims",
    "decision",
    "assertions"
  ],
  "properties": {
    "schema": {
      "const": "ph-m8v-evidence-ledger.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "task": {
      "const": "TASK-V08"
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "complete"
    },
    "sourceEvidence": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "humanReviewSessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/humanReviewRef"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 14,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerState",
        "humanAdjudicationEvidencePresent",
        "radialPromotionReady",
        "superficialStructurePromotionReady",
        "namedSuperficialPromotionReady",
        "nextTask"
      ],
      "properties": {
        "ledgerState": {
          "enum": [
            "blocked-unresolved",
            "partially-adjudicated",
            "promotion-ready"
          ]
        },
        "humanAdjudicationEvidencePresent": {
          "type": "boolean"
        },
        "radialPromotionReady": {
          "type": "boolean"
        },
        "superficialStructurePromotionReady": {
          "type": "boolean"
        },
        "namedSuperficialPromotionReady": {
          "type": "boolean"
        },
        "nextTask": {
          "const": "TASK-V09"
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "medicalValidation",
        "patientSpaceGeometry",
        "procedureRoleEstablished",
        "automaticPromotionAllowed"
      ],
      "properties": {
        "medicalValidation": {
          "const": false
        },
        "patientSpaceGeometry": {
          "const": false
        },
        "procedureRoleEstablished": {
          "const": false
        },
        "automaticPromotionAllowed": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "sha256", "role"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "humanReviewRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "reviewerReference", "decisionCount"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewerReference": {
          "type": "string",
          "minLength": 1
        },
        "decisionCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "claimEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "description"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "requirement",
        "state",
        "supportingEvidence",
        "conflictingEvidence",
        "missingEvidence",
        "humanReviewStatus",
        "humanReviewTargetId",
        "validationLevel",
        "promotionEligible"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "enum": [
            "radial-artery",
            "superficial-vein",
            "named-superficial-vein"
          ]
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "supported",
            "conflicting",
            "missing",
            "blocked",
            "unresolved"
          ]
        },
        "supportingEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimEvidence"
          }
        },
        "conflictingEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimEvidence"
          }
        },
        "missingEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "humanReviewStatus": {
          "enum": ["not-reviewed", "accepted", "rejected", "unresolved"]
        },
        "validationLevel": {
          "enum": ["V0", "V1", "V2", "V3", "V4"]
        },
        "promotionEligible": {
          "type": "boolean"
        },
        "humanReviewTargetId": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    }
  }
}

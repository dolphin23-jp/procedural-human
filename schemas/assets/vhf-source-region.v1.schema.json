{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.dev/schemas/assets/vhf-source-region/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "kind": {
      "const": "vhf-source-region"
    },
    "inventorySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "archiveIndexSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coordinateSpace": {
      "const": "source-image-stack"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patientSpace": {
          "const": false
        },
        "registeredCT": {
          "const": false
        },
        "medicalValidation": {
          "const": false
        },
        "medicalMaster": {
          "const": false
        },
        "runtimeAsset": {
          "const": false
        }
      },
      "required": [
        "patientSpace",
        "registeredCT",
        "medicalValidation",
        "medicalMaster",
        "runtimeAsset"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstFrame": {
          "type": "integer",
          "minimum": 0
        },
        "lastFrame": {
          "type": "integer",
          "minimum": 0
        },
        "cropPixels": {
          "type": ["array", "null"],
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": ["firstFrame", "lastFrame", "cropPixels"]
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "sourceFilename": {
            "type": "string",
            "minLength": 1
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "chunkSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "outputFilename": {
            "type": "string",
            "minLength": 1
          },
          "outputSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "derivation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "index",
          "sourceFilename",
          "sourcePath",
          "sourceSha256",
          "chunkSha256",
          "outputFilename",
          "outputSha256",
          "derivation"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "inventorySha256",
    "archiveIndexSha256",
    "coordinateSpace",
    "claims",
    "selection",
    "frames"
  ]
}

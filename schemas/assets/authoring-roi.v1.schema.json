{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.dev/schemas/assets/authoring-roi/v1",
  "title": "Medical Authoring ROI Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "roiId",
    "sourceArchiveId",
    "status",
    "laterality",
    "region",
    "purpose",
    "coordinateContract",
    "sourceSpaceAcquisition",
    "selectionProtocol",
    "blockingChecks",
    "completedChecks",
    "knownSourceConstraint",
    "completionCondition"
  ],
  "properties": {
    "schema": { "const": "ph-authoring-roi.v1" },
    "schemaVersion": { "const": "1" },
    "roiId": { "type": "string", "minLength": 1 },
    "sourceArchiveId": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "laterality": { "const": "left" },
    "region": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "coordinateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredInput",
        "frameOfReferenceUid",
        "patientSpaceExtent",
        "extentSemantics",
        "selectedSopInstanceUids",
        "pixelCrop"
      ],
      "properties": {
        "requiredInput": { "type": "string", "minLength": 1 },
        "frameOfReferenceUid": { "type": ["string", "null"] },
        "patientSpaceExtent": { "type": ["object", "null"] },
        "extentSemantics": { "type": "string", "minLength": 1 },
        "selectedSopInstanceUids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "pixelCrop": { "type": ["object", "null"] }
      }
    },
    "sourceSpaceAcquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisitionId",
        "sourceRange",
        "cropPixels",
        "provisionalRadiocarpalLevelCandidate",
        "provisionalLandmarkStatus",
        "artifactDigest",
        "sourceHashStatus",
        "coordinateWarning"
      ],
      "properties": {
        "acquisitionId": { "type": "string", "minLength": 1 },
        "sourceRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first", "last", "frameCount", "nominalIntervalMm"],
          "properties": {
            "first": { "const": "avf1567a.png" },
            "last": { "const": "avf1717a.png" },
            "frameCount": { "const": 451 },
            "nominalIntervalMm": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "cropPixels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "top", "rightExclusive", "bottomExclusive"],
          "properties": {
            "left": { "type": "integer", "minimum": 0 },
            "top": { "type": "integer", "minimum": 0 },
            "rightExclusive": { "type": "integer", "minimum": 1 },
            "bottomExclusive": { "type": "integer", "minimum": 1 }
          }
        },
        "provisionalRadiocarpalLevelCandidate": {
          "type": "string",
          "minLength": 1
        },
        "provisionalLandmarkStatus": { "type": "string", "minLength": 1 },
        "artifactDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceHashStatus": { "type": "string", "minLength": 1 },
        "coordinateWarning": { "type": "string", "minLength": 1 }
      }
    },
    "selectionProtocol": { "type": "object" },
    "blockingChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "completedChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "knownSourceConstraint": { "type": "string", "minLength": 1 },
    "completionCondition": { "type": "string", "minLength": 1 }
  }
}

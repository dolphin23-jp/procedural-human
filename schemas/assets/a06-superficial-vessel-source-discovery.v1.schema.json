{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.dev/schemas/assets/a06-superficial-vessel-source-discovery/v1",
  "title": "A06 Superficial Vessel Source Discovery v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "task",
    "recordedAt",
    "coordinateSpace",
    "searchDefinition",
    "candidateStatistics",
    "tracks",
    "disposition",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "ph-a06-superficial-vessel-source-discovery.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "task": {
      "const": "TASK-A06"
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "patientSpaceClaim"
      ],
      "properties": {
        "kind": {
          "const": "source-image-stack"
        },
        "patientSpaceClaim": {
          "const": false
        }
      }
    },
    "searchDefinition": {
      "type": "object"
    },
    "candidateStatistics": {
      "type": "object",
      "required": [
        "frameCount",
        "framesWithAtLeastOneCandidate",
        "meanCandidatesPerFrame",
        "medianCandidatesPerFrame",
        "maxCandidatesPerFrameObserved"
      ],
      "properties": {
        "frameCount": {
          "const": 451
        },
        "framesWithAtLeastOneCandidate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 451
        },
        "meanCandidatesPerFrame": {
          "type": "number",
          "minimum": 0
        },
        "medianCandidatesPerFrame": {
          "type": "number",
          "minimum": 0
        },
        "maxCandidatesPerFrameObserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80
        }
      }
    },
    "tracks": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "superficialTargetVeinAnatomicalId",
        "targetIdentityEstablished",
        "maskGenerationAllowed",
        "reason"
      ],
      "properties": {
        "superficialTargetVeinAnatomicalId": {
          "type": "null"
        },
        "targetIdentityEstablished": {
          "const": false
        },
        "maskGenerationAllowed": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanEdited",
        "anatomicallyReviewed",
        "medicalValidation",
        "namedVeinIdentityEstablished",
        "superficialTargetVeinIdentityEstablished",
        "vesselMaskGenerated",
        "centerlineGenerated",
        "patientSpaceGeometry",
        "automaticPromotionAllowed"
      ],
      "properties": {
        "humanEdited": {
          "const": false
        },
        "anatomicallyReviewed": {
          "const": false
        },
        "medicalValidation": {
          "const": false
        },
        "namedVeinIdentityEstablished": {
          "const": false
        },
        "superficialTargetVeinIdentityEstablished": {
          "const": false
        },
        "vesselMaskGenerated": {
          "const": false
        },
        "centerlineGenerated": {
          "const": false
        },
        "patientSpaceGeometry": {
          "const": false
        },
        "automaticPromotionAllowed": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "required": [
        "rank",
        "nodeCount",
        "spanFrameCount",
        "coverageFraction",
        "firstGlobalFrameIndex",
        "lastGlobalFrameIndex",
        "firstSourceFilename",
        "lastSourceFilename",
        "meanGap",
        "maxGap",
        "meanJumpSourcePixels",
        "maxJumpSourcePixels",
        "medianAreaPixels",
        "medianCircularity",
        "p25Circularity",
        "medianContrast",
        "p25Contrast",
        "medianSkinDepthPixels",
        "p25SkinDepthPixels",
        "p75SkinDepthPixels",
        "meanNodeScore",
        "nodes",
        "discoveryClassification",
        "medianCropBorderDistancePixels",
        "p25CropBorderDistancePixels"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 1
        },
        "spanFrameCount": {
          "type": "integer",
          "minimum": 1
        },
        "coverageFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "firstGlobalFrameIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 450
        },
        "lastGlobalFrameIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 450
        },
        "firstSourceFilename": {
          "type": "string",
          "pattern": "^avf\\d{4}[abc]\\.png$"
        },
        "lastSourceFilename": {
          "type": "string",
          "pattern": "^avf\\d{4}[abc]\\.png$"
        },
        "meanGap": {
          "type": "number",
          "minimum": 0
        },
        "maxGap": {
          "type": "integer",
          "minimum": 0
        },
        "meanJumpSourcePixels": {
          "type": "number",
          "minimum": 0
        },
        "maxJumpSourcePixels": {
          "type": "number",
          "minimum": 0
        },
        "medianAreaPixels": {
          "type": "number",
          "minimum": 0
        },
        "medianCircularity": {
          "type": "number",
          "minimum": 0
        },
        "p25Circularity": {
          "type": "number",
          "minimum": 0
        },
        "medianContrast": {
          "type": "number"
        },
        "p25Contrast": {
          "type": "number"
        },
        "medianSkinDepthPixels": {
          "type": "number",
          "minimum": 0
        },
        "p25SkinDepthPixels": {
          "type": "number",
          "minimum": 0
        },
        "p75SkinDepthPixels": {
          "type": "number",
          "minimum": 0
        },
        "meanNodeScore": {
          "type": "number"
        },
        "nodes": {
          "type": "array",
          "minItems": 1
        },
        "discoveryClassification": {
          "enum": [
            "continuous-superficial-vessel-track-candidate",
            "diagnostic-track-only"
          ]
        },
        "medianCropBorderDistancePixels": {
          "type": "number",
          "minimum": 20
        },
        "p25CropBorderDistancePixels": {
          "type": "number",
          "minimum": 20
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.local/schemas/assets/m8v-superficial-venous-network-evidence/v1",
  "$comment": "TASK-V06 keeps observed superficial vessel tracks separate from derived continuation hypotheses and named-vein identity.",
  "title": "M8V superficial venous network evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "task",
    "recordedAt",
    "status",
    "sourceEvidence",
    "continuityPolicy",
    "trackAudit",
    "continuationHypotheses",
    "networkSummary",
    "promotionGateEvaluations",
    "decision",
    "claims"
  ],
  "properties": {
    "schema": { "const": "ph-m8v-superficial-venous-network-evidence.v1" },
    "schemaVersion": { "const": "1" },
    "task": { "const": "TASK-V06" },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "const": "complete" },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackGraph", "landmarkGraph", "sameSubjectContinuity"],
      "properties": {
        "trackGraph": { "$ref": "#/$defs/sourceRef" },
        "landmarkGraph": { "$ref": "#/$defs/sourceRef" },
        "sameSubjectContinuity": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "continuityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "maxFrameDelta",
        "maxJumpPerFramePixels",
        "jumpSlackPixels",
        "procedureRelevantMinimumSpanFrames",
        "hypothesesCountAsDirectObservation"
      ],
      "properties": {
        "origin": { "const": "TASK-AS06-fixed-superficial-search-criteria" },
        "maxFrameDelta": { "const": 4 },
        "maxJumpPerFramePixels": { "const": 7 },
        "jumpSlackPixels": { "const": 3 },
        "procedureRelevantMinimumSpanFrames": { "const": 90 },
        "hypothesesCountAsDirectObservation": { "const": false }
      }
    },
    "trackAudit": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trackAudit" }
    },
    "continuationHypotheses": {
      "type": "array",
      "items": { "$ref": "#/$defs/hypothesis" }
    },
    "networkSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anonymousTrackCount",
        "directProcedureRelevantTrackCount",
        "directContinuousCandidateCount",
        "hypothesisLinkCount",
        "maxDirectSpanFrames",
        "superficialDepthSupportedTrackCount",
        "veinClassSupportedTrackCount",
        "competitorResolutionStatus"
      ],
      "properties": {
        "anonymousTrackCount": { "type": "integer", "minimum": 1 },
        "directProcedureRelevantTrackCount": {
          "type": "integer",
          "minimum": 0
        },
        "directContinuousCandidateCount": { "type": "integer", "minimum": 0 },
        "hypothesisLinkCount": { "type": "integer", "minimum": 0 },
        "maxDirectSpanFrames": { "type": "integer", "minimum": 2 },
        "superficialDepthSupportedTrackCount": {
          "type": "integer",
          "minimum": 0
        },
        "veinClassSupportedTrackCount": { "type": "integer", "minimum": 0 },
        "competitorResolutionStatus": { "type": "string", "minLength": 1 }
      }
    },
    "promotionGateEvaluations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/gate" }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observedSuperficialVeinStructureEstablished",
        "namedSuperficialVeinIdentityEstablished",
        "candidateSelected",
        "nextTask",
        "blockingGateIds"
      ],
      "properties": {
        "state": {
          "enum": ["promotable-observed-structure", "blocked-unresolved"]
        },
        "observedSuperficialVeinStructureEstablished": { "type": "boolean" },
        "namedSuperficialVeinIdentityEstablished": { "const": false },
        "candidateSelected": { "type": ["string", "null"] },
        "nextTask": { "const": "TASK-V07" },
        "blockingGateIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sameSubjectSuperficialNetworkEvidenceAssessed",
        "superficialVeinClassEstablished",
        "observedSuperficialVeinStructureEstablished",
        "namedSuperficialVeinIdentityEstablished",
        "procedureRoleEstablished",
        "patientSpaceGeometry",
        "physical3DGeometry",
        "medicalValidation",
        "automaticPromotionAllowed"
      ],
      "properties": {
        "sameSubjectSuperficialNetworkEvidenceAssessed": { "const": true },
        "superficialVeinClassEstablished": { "type": "boolean" },
        "observedSuperficialVeinStructureEstablished": { "type": "boolean" },
        "namedSuperficialVeinIdentityEstablished": { "const": false },
        "procedureRoleEstablished": { "const": false },
        "patientSpaceGeometry": { "const": false },
        "physical3DGeometry": { "const": false },
        "medicalValidation": { "const": false },
        "automaticPromotionAllowed": { "const": false }
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "schema": { "type": "string", "minLength": 1 }
      }
    },
    "trackAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trackId",
        "sourceClassification",
        "observationCount",
        "spanFrameCount",
        "coverageFraction",
        "maxMissingFrameCount",
        "medianDepthPixels",
        "directProcedureRelevantExtent",
        "meetsDirectContinuityCriteria",
        "vesselClassStatus",
        "namedIdentityStatus",
        "reviewStatus"
      ],
      "properties": {
        "trackId": { "type": "string", "minLength": 1 },
        "sourceClassification": { "type": "string", "minLength": 1 },
        "observationCount": { "type": "integer", "minimum": 2 },
        "spanFrameCount": { "type": "integer", "minimum": 2 },
        "coverageFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxMissingFrameCount": { "type": "integer", "minimum": 0 },
        "medianDepthPixels": { "type": ["number", "null"], "minimum": 0 },
        "directProcedureRelevantExtent": { "type": "boolean" },
        "meetsDirectContinuityCriteria": { "type": "boolean" },
        "vesselClassStatus": { "type": "string", "minLength": 1 },
        "namedIdentityStatus": { "const": "anonymous-unresolved" },
        "reviewStatus": { "type": "string", "minLength": 1 }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fromTrackId",
        "toTrackId",
        "frameDelta",
        "missingFrameCount",
        "endpointDistancePixels",
        "status",
        "directContinuityClaim",
        "identityImplicationAllowed"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fromTrackId": { "type": "string", "minLength": 1 },
        "toTrackId": { "type": "string", "minLength": 1 },
        "frameDelta": { "type": "integer", "minimum": 1, "maximum": 4 },
        "missingFrameCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "endpointDistancePixels": { "type": "number", "minimum": 0 },
        "status": { "const": "derived-continuation-hypothesis-only" },
        "directContinuityClaim": { "const": false },
        "identityImplicationAllowed": { "const": false }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "status", "evidence", "reason"],
      "properties": {
        "id": {
          "enum": [
            "direct-observation-over-procedure-relevant-extent",
            "single-structure-continuity",
            "superficial-subcutaneous-relationship",
            "vein-class-evidence",
            "competing-track-conflict-review",
            "explicit-human-anatomical-review"
          ]
        },
        "requirement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "insufficient"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}

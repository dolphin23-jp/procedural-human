{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.dev/schemas/assets/medical-master-readiness/v1",
  "title": "Medical Master Readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "task",
    "recordedAt",
    "status",
    "blockers",
    "claims"
  ],
  "properties": {
    "schema": { "const": "ph-medical-master-readiness.v1" },
    "schemaVersion": { "const": "1" },
    "task": { "const": "TASK-A10" },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "enum": ["blocked", "ready"] },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "medicalMasterCreated",
        "medicalValidation",
        "patientSpaceGeometry",
        "automaticPromotionAllowed"
      ],
      "properties": {
        "medicalMasterCreated": { "const": false },
        "medicalValidation": { "const": false },
        "patientSpaceGeometry": { "const": false },
        "automaticPromotionAllowed": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "blocked" } } },
      "then": { "properties": { "blockers": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "ready" } } },
      "then": { "properties": { "blockers": { "maxItems": 0 } } }
    }
  ]
}

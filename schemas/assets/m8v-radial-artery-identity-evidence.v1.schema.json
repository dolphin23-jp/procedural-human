{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.local/schemas/assets/m8v-radial-artery-identity-evidence/v1",
  "$comment": "recordedAt uses an explicit YYYY-MM-DD pattern because the repository Ajv strict validator does not install format plugins.",
  "title": "M8V radial artery identity evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "task",
    "recordedAt",
    "status",
    "targetIdentity",
    "sourceEvidence",
    "candidateAudit",
    "promotionGateEvaluations",
    "decision",
    "claims"
  ],
  "properties": {
    "schema": { "const": "ph-m8v-radial-artery-identity-evidence.v1" },
    "schemaVersion": { "const": "1" },
    "task": { "const": "TASK-V05" },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "const": "complete" },
    "targetIdentity": { "const": "structure.radial_artery.left" },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registrationScaffold",
        "landmarkGraph",
        "trackGraph",
        "sameSubjectContinuity"
      ],
      "properties": {
        "registrationScaffold": { "$ref": "#/$defs/sourceRef" },
        "landmarkGraph": { "$ref": "#/$defs/sourceRef" },
        "trackGraph": { "$ref": "#/$defs/sourceRef" },
        "sameSubjectContinuity": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "candidateAudit": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidateAudit" }
    },
    "promotionGateEvaluations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/gate" }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "allRequiredGatesPass",
        "radialArteryPromotionAllowed",
        "candidateSelected",
        "nextTask",
        "blockingGateIds"
      ],
      "properties": {
        "state": { "enum": ["promotable", "blocked-unresolved"] },
        "allRequiredGatesPass": { "type": "boolean" },
        "radialArteryPromotionAllowed": { "type": "boolean" },
        "candidateSelected": { "type": ["string", "null"] },
        "nextTask": { "const": "TASK-V06" },
        "blockingGateIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radialArteryIdentityEstablished",
        "brachialArteryIdentityEstablished",
        "bifurcationIdentityEstablished",
        "patientSpaceGeometry",
        "physical3DGeometry",
        "medicalValidation",
        "automaticPromotionAllowed"
      ],
      "properties": {
        "radialArteryIdentityEstablished": { "type": "boolean" },
        "brachialArteryIdentityEstablished": { "type": "boolean" },
        "bifurcationIdentityEstablished": { "type": "boolean" },
        "patientSpaceGeometry": { "const": false },
        "physical3DGeometry": { "const": false },
        "medicalValidation": { "const": false },
        "automaticPromotionAllowed": { "const": false }
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "schema": { "type": "string", "minLength": 1 }
      }
    },
    "candidateAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trackId",
        "sourceClassification",
        "observationCount",
        "spanFrameCount",
        "coverageFraction",
        "gapLinkCount",
        "maxMissingFrameCount",
        "namedIdentityStatus",
        "reviewStatus",
        "selectionStatus"
      ],
      "properties": {
        "trackId": { "type": "string", "minLength": 1 },
        "sourceClassification": { "type": "string", "minLength": 1 },
        "observationCount": { "type": "integer", "minimum": 2 },
        "spanFrameCount": { "type": "integer", "minimum": 2 },
        "coverageFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "gapLinkCount": { "type": "integer", "minimum": 0 },
        "maxMissingFrameCount": { "type": "integer", "minimum": 0 },
        "namedIdentityStatus": { "const": "anonymous-unresolved" },
        "reviewStatus": { "type": "string", "minLength": 1 },
        "selectionStatus": { "const": "not-selected-competing-candidate" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "status", "evidence", "reason"],
      "properties": {
        "id": {
          "enum": [
            "unique-same-subject-arterial-anchor",
            "bounded-gap-continuity-to-target",
            "compatible-branch-topology",
            "compatible-landmark-relationships",
            "no-equal-or-better-competing-candidate",
            "explicit-human-anatomical-review"
          ]
        },
        "requirement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "insufficient"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.dev/schemas/assets/a06-multimodality-bone-candidate-report/v1",
  "title": "A06 Multimodality Bone Candidate Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "task",
    "pipelineProfile",
    "status",
    "coordinateSpace",
    "support",
    "sameCadaverCtEvidence",
    "structures",
    "claims",
    "software"
  ],
  "properties": {
    "schema": { "const": "ph-a06-multimodality-bone-candidate-report.v1" },
    "schemaVersion": { "const": "1" },
    "task": { "const": "TASK-A06" },
    "pipelineProfile": { "type": "string", "minLength": 1 },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationLevel", "reviewStatus", "candidateOnly"],
      "properties": {
        "validationLevel": { "const": "V0" },
        "reviewStatus": { "const": "unreviewed" },
        "candidateOnly": { "const": true }
      }
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "patientSpaceClaim", "ctRegistrationEstablished"],
      "properties": {
        "kind": { "const": "source-image-stack" },
        "patientSpaceClaim": { "const": false },
        "ctRegistrationEstablished": { "const": false }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaning",
        "firstGlobalFrameIndex",
        "lastGlobalFrameIndex",
        "firstSourceFilename",
        "lastSourceFilename",
        "supportedFrameCount",
        "outsideSupportDisposition"
      ],
      "properties": {
        "meaning": { "type": "string", "minLength": 1 },
        "firstGlobalFrameIndex": { "type": "integer", "minimum": 0 },
        "lastGlobalFrameIndex": { "type": "integer", "minimum": 0 },
        "firstSourceFilename": { "type": "string", "minLength": 1 },
        "lastSourceFilename": { "type": "string", "minLength": 1 },
        "supportedFrameCount": { "type": "integer", "minimum": 1 },
        "outsideSupportDisposition": { "const": "not-supported-by-this-pass" }
      }
    },
    "sameCadaverCtEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominalIndexStart",
        "nominalIndexStop",
        "ctBoneThresholdStoredValue",
        "identityAssignment",
        "affineCorroboration"
      ],
      "properties": {
        "nominalIndexStart": { "type": "integer" },
        "nominalIndexStop": { "type": "integer" },
        "ctBoneThresholdStoredValue": { "type": "integer" },
        "identityAssignment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["radius", "ulna"],
          "properties": {
            "radius": { "type": "string", "minLength": 1 },
            "ulna": { "type": "string", "minLength": 1 }
          }
        },
        "affineCorroboration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directMeanResidualPixels",
            "directMedianResidualPixels",
            "swappedMeanResidualPixels",
            "swappedMedianResidualPixels",
            "directToSwappedMeanRatio",
            "directAssignmentClearlyPreferred",
            "transformCtPixelsToCryosectionCropPixels"
          ],
          "properties": {
            "directMeanResidualPixels": { "type": "number", "minimum": 0 },
            "directMedianResidualPixels": { "type": "number", "minimum": 0 },
            "swappedMeanResidualPixels": { "type": "number", "minimum": 0 },
            "swappedMedianResidualPixels": { "type": "number", "minimum": 0 },
            "directToSwappedMeanRatio": { "type": "number", "minimum": 0 },
            "directAssignmentClearlyPreferred": { "const": true },
            "transformCtPixelsToCryosectionCropPixels": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "structures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "draftLabel",
          "semanticId",
          "representationStatus",
          "supportedFrameCount",
          "minCandidatePixelsPerSupportedFrame",
          "maxCandidatePixelsPerSupportedFrame",
          "meanCandidatePixelsPerSupportedFrame",
          "files"
        ],
        "properties": {
          "draftLabel": { "enum": ["radius", "ulna"] },
          "semanticId": { "type": "string", "pattern": "^structure\\.(radius|ulna)\\.left$" },
          "representationStatus": { "const": "partial-support-v0-candidate" },
          "supportedFrameCount": { "type": "integer", "minimum": 1 },
          "minCandidatePixelsPerSupportedFrame": { "type": "integer", "minimum": 1 },
          "maxCandidatePixelsPerSupportedFrame": { "type": "integer", "minimum": 1 },
          "meanCandidatePixelsPerSupportedFrame": { "type": "number", "minimum": 0 },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "globalFrameIndex",
                "sourceFilename",
                "candidatePixels",
                "centroidSourcePixels",
                "anchorSourcePixels",
                "appearanceRuleIndex",
                "maskPath",
                "maskSha256"
              ],
              "properties": {
                "globalFrameIndex": { "type": "integer", "minimum": 0 },
                "sourceFilename": { "type": "string", "minLength": 1 },
                "candidatePixels": { "type": "integer", "minimum": 1 },
                "centroidSourcePixels": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y"],
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  }
                },
                "anchorSourcePixels": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y"],
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  }
                },
                "appearanceRuleIndex": { "type": "integer", "minimum": 0 },
                "maskPath": { "type": "string", "minLength": 1 },
                "maskSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanEdited",
        "anatomicallyReviewed",
        "medicalValidation",
        "completeStructureExtent",
        "patientSpaceGeometry",
        "ctRegistrationEstablished",
        "atlasGeometryUsedAsSubjectGeometry",
        "automaticPromotionAllowed"
      ],
      "properties": {
        "humanEdited": { "const": false },
        "anatomicallyReviewed": { "const": false },
        "medicalValidation": { "const": false },
        "completeStructureExtent": { "const": false },
        "patientSpaceGeometry": { "const": false },
        "ctRegistrationEstablished": { "const": false },
        "atlasGeometryUsedAsSubjectGeometry": { "const": false },
        "automaticPromotionAllowed": { "const": false }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numpyVersion", "opencvVersion", "pillowVersion"],
      "properties": {
        "numpyVersion": { "type": "string", "minLength": 1 },
        "opencvVersion": { "type": "string", "minLength": 1 },
        "pillowVersion": { "type": ["string", "null"] }
      }
    }
  }
}

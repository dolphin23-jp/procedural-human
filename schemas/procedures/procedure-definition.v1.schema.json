{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-human.dev/schemas/procedures/procedure-definition/v1",
  "title": "Procedure Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "procedureId",
    "version",
    "name",
    "goals",
    "dependencies",
    "semanticRoles",
    "safetyRules",
    "completionCriteria"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "procedureId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "eventType"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "eventType": { "type": "string", "minLength": 1 },
          "targetRole": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goalId", "dependsOnGoalIds"],
        "properties": {
          "goalId": { "type": "string", "minLength": 1 },
          "dependsOnGoalIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "semanticRoles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "safetyRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "eventType"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "eventType": { "type": "string", "minLength": 1 },
          "targetRole": { "type": "string", "minLength": 1 }
        }
      }
    },
    "completionCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredGoalIds"],
      "properties": {
        "requiredGoalIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
